# soc-cloud's environment, as contracts/config/soc-config.schema.json declares it.
# Copy to soc-cloud.env; never commit it.
SOC_HEALTH_PORT=8080
SOC_FLIGHT_FILES_PORT=8090
SOC_DB_HOST=db
SOC_DB_PORT=5432
SOC_DB_NAME=postgres
SOC_DB_PASSWORD_SOC_CLOUD=replace-with-the-same-secret-as-migrate.env
SOC_SUPABASE_URL=http://kong:8000
SOC_SUPABASE_SERVICE_ROLE_KEY=replace-with-virtual-origen-service-role-key
# One pair per stack in soc-cloud.json, named by its password_env and token_env.
SOC_MQTT_PASSWORD_LAB=replace-with-sky-orchestrator-cloud-client-password
SOC_SO_API_TOKEN_LAB=replace-with-sky-orchestrator-wayline-api-token
