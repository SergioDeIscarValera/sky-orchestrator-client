# soc-migrate's environment. Copy to migrate.env; never commit it.
# Virtual Origen's Postgres as its owner role, on Virtual Origen's network.
SOC_MIGRATE_DSN=postgresql://postgres:replace-with-the-postgres-password@db:5432/postgres
# The login roles' passwords, set by the runner: letters and digits, 32 or more.
SOC_DB_PASSWORD_SOC_CLOUD=replace-with-a-generated-secret
SOC_DB_PASSWORD_SOC_OPERATIONS=replace-with-a-generated-secret
