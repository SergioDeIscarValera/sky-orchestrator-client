{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "lint-rules.d.ts",
    "scripts/secrets.d.mts",
    "scripts/demo/fake-supabase.d.mts",
    "scripts/demo/run.d.mts",
    "scripts/measure/path.d.mts",
    "scripts/measure/memory.d.mts",
    "scripts/e2e/frames.d.mts"
  ]
}
