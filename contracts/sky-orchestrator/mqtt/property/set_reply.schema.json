{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergioDeIscarValera/sky-orchestrator/blob/develop/contracts/mqtt/property/set_reply.schema.json",
  "title": "property/set_reply",
  "description": "Dock to cloud on thing/product/{gateway_sn}/property/set_reply: each property named with its result, 0 success, 1 failed, 2 timeout (PropertySetReplyResultEnum). The emulator has no settable property: every one is answered 1.",
  "x-version": "1.0.0",
  "x-topic": "thing/product/{gateway_sn}/property/set_reply",
  "x-direction": "dock_to_cloud",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tid",
    "bid",
    "timestamp",
    "data"
  ],
  "properties": {
    "tid": {
      "$ref": "../dji-envelope.schema.json#/$defs/tid"
    },
    "bid": {
      "$ref": "../dji-envelope.schema.json#/$defs/bid"
    },
    "timestamp": {
      "$ref": "../dji-envelope.schema.json#/$defs/timestamp"
    },
    "data": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "enum": [
              0,
              1,
              2
            ]
          }
        }
      }
    }
  }
}
