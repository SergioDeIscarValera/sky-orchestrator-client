{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergioDeIscarValera/sky-orchestrator/blob/develop/contracts/mqtt/services/request.schema.json",
  "title": "A service request",
  "description": "Cloud to dock on thing/product/{gateway_sn}/services: any method. From mqtt/services/TopicServicesRequest: data is the method's, or an empty string for a method with none, which is what DJI's ServicesPublish sends. A method's own data is held to its own schema, beside this one.",
  "x-version": "1.0.0",
  "x-topic": "thing/product/{gateway_sn}/services",
  "x-direction": "cloud_to_dock",
  "type": "object",
  "required": [
    "tid",
    "bid",
    "timestamp",
    "method"
  ],
  "properties": {
    "tid": {
      "$ref": "../dji-envelope.schema.json#/$defs/tid"
    },
    "bid": {
      "$ref": "../dji-envelope.schema.json#/$defs/bid"
    },
    "timestamp": {
      "$ref": "../dji-envelope.schema.json#/$defs/timestamp"
    },
    "method": {
      "$ref": "../dji-envelope.schema.json#/$defs/method"
    },
    "data": {
      "type": [
        "object",
        "string",
        "null"
      ]
    }
  }
}
