{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergioDeIscarValera/sky-orchestrator/blob/develop/contracts/mqtt/events/flighttask_progress.schema.json",
  "title": "flighttask_progress",
  "description": "From DJI's SDK at bef525cb: TopicEventsRequest of EventsDataRequest of cloudapi/wayline/FlighttaskProgress. bid is the flight id, as the prepare that created the task carried it: DJI's demo cloud finds the job by it. Published at progress_publish_hz while the task is unfinished, and once when it finishes (FR-FLT-04). need_reply is 0: DJI's demo cloud does not answer it. 1.1.0: ext.break_point.break_reason carries why the mission stopped on its own, from DJI's FlighttaskBreakReasonEnum; it was always 0 (FR-FLT-12). 1.2.0: ext.current_waypoint_index never goes back within an execution. Through the finish action, and after a stop, it holds the last waypoint the route flew to; it read 0 there (FR-FLT-04).",
  "x-version": "1.2.0",
  "x-topic": "thing/product/{gateway_sn}/events",
  "x-direction": "dock_to_cloud",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tid",
    "bid",
    "timestamp",
    "gateway",
    "method",
    "need_reply",
    "data"
  ],
  "properties": {
    "tid": {
      "$ref": "../dji-envelope.schema.json#/$defs/own_id"
    },
    "bid": {
      "$ref": "../dji-envelope.schema.json#/$defs/bid"
    },
    "timestamp": {
      "$ref": "../dji-envelope.schema.json#/$defs/timestamp"
    },
    "gateway": {
      "$ref": "../dji-envelope.schema.json#/$defs/sn"
    },
    "method": {
      "const": "flighttask_progress"
    },
    "need_reply": {
      "$ref": "../dji-envelope.schema.json#/$defs/flag"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "output"
      ],
      "properties": {
        "result": {
          "$ref": "../dji-envelope.schema.json#/$defs/result"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ext",
            "progress",
            "status"
          ],
          "properties": {
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "current_waypoint_index",
                "media_count",
                "flight_id",
                "wayline_mission_state",
                "wayline_id"
              ],
              "properties": {
                "current_waypoint_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The waypoint the route flies to, from 0. Off the route it is the breakpoint's, else the last the route flew to (0 before it), so it never goes back within an execution (FR-FLT-04, since 1.2.0). The finish action holds the last waypoint: wayline_mission_state says when the route is over."
                },
                "media_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "flight_id": {
                  "type": "string",
                  "minLength": 1
                },
                "wayline_mission_state": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9,
                  "description": "WaylineMissionStateEnum: 2 prepared, 4 taking off, 5 to the first waypoint, 6 on the route, 7 paused or interrupted, and 9 once the route is over, through the finish action's return or landing, a stop's return, and at the end."
                },
                "wayline_id": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The wayline's index in the file: always 0, the one wayline the subset allows."
                },
                "break_point": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "index",
                    "state",
                    "progress",
                    "wayline_id",
                    "break_reason"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "state": {
                      "enum": [
                        0,
                        1
                      ],
                      "description": "BreakpointStateEnum: on the segment, or on the waypoint."
                    },
                    "progress": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "wayline_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "break_reason": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "FlighttaskBreakReasonEnum: why the mission stopped on its own (FR-FLT-12). 1282 a pilot takeover, 773 low battery, 775 a lost link, 514 an envelope breach, 1564 the flight code's own failsafe, 2 an aircraft fault, 65534 the aircraft acting on its own. 0 for an operator's pause. Kept through a return and a landing until the mission resumes."
                    },
                    "attitude_head": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  }
                }
              }
            },
            "progress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "current_step",
                "percent"
              ],
              "properties": {
                "current_step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535,
                  "description": "ExecutionStepEnum: 22 while the aircraft returns home, the finish action's or a stop's."
                },
                "percent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "status": {
              "enum": [
                "sent",
                "in_progress",
                "ok",
                "paused",
                "rejected",
                "failed",
                "canceled",
                "timeout",
                "partially_done"
              ],
              "description": "FlighttaskStatusEnum."
            }
          }
        }
      }
    }
  }
}
