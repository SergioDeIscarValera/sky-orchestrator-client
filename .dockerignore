!pyproject.toml
!uv.lock
!contracts/
!database/pyproject.toml
!database/migrations/
!infra/migrate/
!libs/
!services/
!apps/soc-web/
apps/soc-web/node_modules/
apps/soc-web/dist/
**/tests/
**/__pycache__/
**/.venv/
